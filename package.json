  "description": "Obsidian Git-like Google Drive version control plugin via Rclone.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "rollup --config rollup.config.js --environment BUILD:production",
    "dev": "rollup --config rollup.config.js -w"
  },
